# Copy to frontend/.env.local for local development.
# Never commit real secrets.

# Application
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local documents
# Defaults to ../local-documents when running from frontend/.
LOCAL_DOCUMENTS_DIR=../local-documents
LOCAL_INDEX_DIR=../.data/local-index

# Nexi prototype verification
# NEXI_OTP=false enables the simulated OTP flow used by the v0.2 prototype.
# Production must not run with NEXI_OTP=false.
NEXI_OTP=false
# Set true only on Vercel deployments that are explicitly being used for prototype testing.
NEXI_ALLOW_PROTOTYPE_OTP=false
NEXI_OTP_EMAIL=ciaran.quinlan@nexted.com.au
NEXI_DEV_OTP=45454545

# Canvas OAuth
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:3000/api/auth/canvas/callback

# Canvas MCP
# HTTP endpoint for the deployed Canvas MCP server, e.g. https://your-mcp.vercel.app
CANVAS_MCP_URL=
# Relative MCP endpoint path under CANVAS_MCP_URL.
CANVAS_MCP_API_PATH=api/mcp
# Server-side Canvas token used by the temporary email lookup flow.
# This is for dev/demo only; production should require OAuth/SSO before returning student data.
CANVAS_MCP_TOKEN=
CANVAS_MCP_CANVAS_URL=
# Optional bearer token if the MCP deployment itself is protected.
CANVAS_MCP_BEARER_TOKEN=
# Stdio command for future local development. The current profile flow uses CANVAS_MCP_URL.
CANVAS_MCP_COMMAND=canvas-mcp-server

# Nexi Student Hub
# Defaults match the v0.3 AIT Student Hub spec.
NEXI_STUDENT_HUB_COURSE_ID=5704
NEXI_STUDENT_HUB_ACCOUNT_ID=1
NEXI_STUDENT_HUB_ACCOUNT_NAME=Technology & Design (T&D)
NEXI_STUDENT_HUB_NAME=AIT Student Hub
NEXI_STUDENT_HUB_CANVAS_URL=https://ait.instructure.com/courses/5704
